'.streamlit/config.toml': '[theme]\nbase="dark"\nprimaryColor="#3b82f6"\nbackgroundColor="#0b1020"\nsecondaryBackgroundColor="#111827"\ntextColor="#e5e7eb"\n'
}
for name, content in files.items():
    p = base / name
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(content)
print('Created files in', base)
for p in base.rglob('*'):
    if p.is_file():
